DOMAIN=mail.example.com
ACME_EMAIL=admin@example.com
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
GMAIL_OAUTH_CLIENT_ID=replace-with-gmail-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=replace-with-gmail-oauth-client-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Also set on the Convex deployment: npx convex env set MAIL_ENCRYPTION_KEY ...
MAIL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
VAPID_PUBLIC_KEY=
